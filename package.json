{
  "name": "pomo",
  "version": "1.0.0",
  "description": "Terminal Pomodoro + Distraction Tracker",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pomo": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "start": "node dist/cli.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "ink": "^5.0.0",
    "node-notifier": "^10.0.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^1.0.0"
  }
}
